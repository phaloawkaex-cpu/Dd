--[[
  LUCKY BLOCK ADMIN PANEL  (สำหรับแมพของคุณเองใน Roblox Studio)
  ฟังก์ชัน: อมตะ / เสกลัคกี้บล็อคทุกแบบ / ปรับระยะตี 1-100 / บิน
  โบนัส: ความเร็ว, กระโดดไม่จำกัด, ทะลุกำแพง, เก็บบล็อคอัตโนมัติ, กันตกแมพ

  วิธีติดตั้ง (3 ขั้นตอน):
  1) สร้างโฟลเดอร์ชื่อ "LuckyBlocks" ใน ServerStorage แล้วใส่ลัคกี้บล็อคทุกแบบของคุณลงไป
     (เป็น Part หรือ Model ก็ได้)
  2) สร้าง "Script" ใน ServerScriptService แล้ววางโค้ดส่วน [SERVER] ด้านล่าง
  3) สร้าง "LocalScript" ใน StarterPlayer > StarterPlayerScripts แล้ววางโค้ดส่วน [CLIENT]

  ใส่ UserId ของคุณใน ADMINS (ใน Studio ทุกคนใช้ได้อัตโนมัติ)
]]

--==================================================================
-- [SERVER]  →  Script ใน ServerScriptService
--==================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local ADMINS = { 123456789 } -- ใส่ UserId ของคุณ
local BLOCK_FOLDER = "LuckyBlocks"

local remote = Instance.new("RemoteEvent")
remote.Name = "LuckyAdminEvent"
remote.Parent = ReplicatedStorage

local state = {} -- state[player] = {god=bool, reach=number, speed=number}

local function isAdmin(plr)
	if RunService:IsStudio() then return true end
	return table.find(ADMINS, plr.UserId) ~= nil
end

local function getState(plr)
	state[plr] = state[plr] or { god = false, reach = 0, speed = 16, autoCollect = false }
	return state[plr]
end

-- ===== อมตะ =====
local function applyGod(plr)
	local s = getState(plr)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	local ff = char:FindFirstChild("AdminFF")
	if s.god then
		hum.MaxHealth = math.huge
		hum.Health = math.huge
		if not ff then
			ff = Instance.new("ForceField")
			ff.Name = "AdminFF"
			ff.Visible = false
			ff.Parent = char
		end
		if not hum:GetAttribute("GodHooked") then
			hum:SetAttribute("GodHooked", true)
			hum.HealthChanged:Connect(function()
				if getState(plr).god and hum.Health < hum.MaxHealth then
					hum.Health = hum.MaxHealth
				end
			end)
		end
	else
		if ff then ff:Destroy() end
		hum.MaxHealth = 100
		hum.Health = 100
	end
end

-- ===== ระยะตี (ขยาย Handle ของอาวุธ) =====
local function applyReachToTool(tool, reach)
	local handle = tool:FindFirstChild("Handle")
	if not (handle and handle:IsA("BasePart")) then return end
	if not handle:GetAttribute("OrigSize") then
		handle:SetAttribute("OrigSize", handle.Size)
	end
	local orig = handle:GetAttribute("OrigSize")
	if reach <= 0 then
		handle.Size = orig
		handle.Transparency = handle:GetAttribute("OrigTrans") or handle.Transparency
		return
	end
	if not handle:GetAttribute("OrigTrans") then
		handle:SetAttribute("OrigTrans", handle.Transparency)
	end
	-- ขยายตามแกน Z (ยาวไปข้างหน้า) 1-100 เท่าของความยาวเดิม
	handle.Size = Vector3.new(orig.X, orig.Y, math.max(orig.Z, reach))
	handle.Massless = true
	handle.CanCollide = false
end

local function applyReach(plr)
	local reach = getState(plr).reach
	for _, container in ipairs({ plr.Character, plr:FindFirstChildOfClass("Backpack") }) do
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") then applyReachToTool(t, reach) end
			end
		end
	end
end

-- ===== เสกลัคกี้บล็อคทุกแบบ =====
local function spawnAll(plr)
	local folder = ServerStorage:FindFirstChild(BLOCK_FOLDER)
	local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not (folder and hrp) then return end

	local items = folder:GetChildren()
	local cols = math.ceil(math.sqrt(#items))
	local spacing = 6
	local origin = hrp.CFrame * CFrame.new(0, 0, -12)

	for i, template in ipairs(items) do
		local clone = template:Clone()
		local x = ((i - 1) % cols - cols / 2) * spacing
		local z = -math.floor((i - 1) / cols) * spacing
		local cf = origin * CFrame.new(x, 2, z)
		if clone:IsA("Model") then
			clone:PivotTo(cf)
		elseif clone:IsA("BasePart") then
			clone.CFrame = cf
			clone.Anchored = true
		end
		clone.Parent = workspace
	end
end

-- ===== เก็บบล็อคอัตโนมัติ (ดึงลัคกี้บล็อคที่มี ClickDetector/Touch) =====
task.spawn(function()
	while true do
		task.wait(0.5)
		for plr, s in pairs(state) do
			if s.autoCollect and plr.Character then
				local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					for _, obj in ipairs(workspace:GetDescendants()) do
						if obj:IsA("BasePart") and obj.Name:lower():find("lucky") and obj.Parent ~= nil then
							if (obj.Position - hrp.Position).Magnitude < 60 and firetouchinterest == nil then
								-- ใช้ได้เฉพาะในเกมของคุณ: วาร์ปบล็อคมาที่ผู้เล่นเพื่อให้ Touched ทำงานตามปกติ
								obj.CFrame = hrp.CFrame * CFrame.new(0, 0, -3)
							end
						end
					end
				end
			end
		end
	end
end)

-- ===== รับคำสั่งจาก Client =====
remote.OnServerEvent:Connect(function(plr, action, value)
	if not isAdmin(plr) then return end
	local s = getState(plr)

	if action == "God" then
		s.god = value == true
		applyGod(plr)
	elseif action == "Reach" then
		s.reach = math.clamp(tonumber(value) or 0, 0, 100)
		applyReach(plr)
	elseif action == "Speed" then
		s.speed = math.clamp(tonumber(value) or 16, 8, 200)
		local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
		if hum then hum.WalkSpeed = s.speed end
	elseif action == "SpawnAll" then
		spawnAll(plr)
	elseif action == "AutoCollect" then
		s.autoCollect = value == true
	end
end)

local function onChar(plr, char)
	local s = getState(plr)
	local hum = char:WaitForChild("Humanoid")
	hum.WalkSpeed = s.speed
	task.wait(0.2)
	applyGod(plr)
	applyReach(plr)
	local bp = plr:WaitForChild("Backpack")
	bp.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then applyReachToTool(c, getState(plr).reach) end
	end)
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then applyReachToTool(c, getState(plr).reach) end
	end)
end

Players.PlayerAdded:Connect(function(plr)
	plr.CharacterAdded:Connect(function(c) onChar(plr, c) end)
end)
for _, plr in ipairs(Players:GetPlayers()) do
	plr.CharacterAdded:Connect(function(c) onChar(plr, c) end)
	if plr.Character then task.spawn(onChar, plr, plr.Character) end
end
Players.PlayerRemoving:Connect(function(plr) state[plr] = nil end)


